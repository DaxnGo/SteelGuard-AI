# Docker Compose demo defaults. The frontend calls the backend over the live
# HTTP path while the backend stays in safe dummy mode until AI is approved.
STEELGUARD_USE_MOCK_API=false
STEELGUARD_API_BASE_URL=http://backend:8000
STEELGUARD_API_CONNECT_TIMEOUT_SECONDS=2
STEELGUARD_API_READ_TIMEOUT_SECONDS=30
STEELGUARD_MAX_UPLOAD_BYTES=1048576

# For a non-Docker local run, change only the base URL:
# STEELGUARD_API_BASE_URL=http://localhost:8000

# Optional mock-development settings
# STEELGUARD_MOCK_RESPONSE_PATH=mock/prediction_response.json
# STEELGUARD_MOCK_DELAY_SECONDS=0.6

# Backend adapter mode. Keep dummy until D-03 recommendation rules and the
# provisional model have been reviewed. Model mode never falls back to dummy.
STEELGUARD_AI_MODE=dummy
# STEELGUARD_MODEL_PATH=/app/ai/best.pt
# STEELGUARD_CONFIDENCE_THRESHOLD=0.25
# STEELGUARD_RECOMMENDATION_MAP_JSON={"Crazing":"<ACCEPT|REWORK|REJECT>","Inclusion":"<ACCEPT|REWORK|REJECT>","Patches":"<ACCEPT|REWORK|REJECT>","Pitted Surface":"<ACCEPT|REWORK|REJECT>","Rolled-in Scale":"<ACCEPT|REWORK|REJECT>","Scratches":"<ACCEPT|REWORK|REJECT>"}

# For isolated frontend development without a backend, use:
# STEELGUARD_USE_MOCK_API=true
